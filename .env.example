# ==============================================================================
# PHONEINTEL (phonekeeda) Environment Configuration Reference
# ==============================================================================
# Copy this file to .env and replace placeholders with secure production values.

# --- Application Core ---
APP_ENV=production                          # Options: development, staging, production, test
FORCE_HTTPS=true                            # Enforces HTTPS redirects and HSTS in production
ENABLE_DOCS=false                           # Disable /docs and /redoc in production environments
LOG_LEVEL=INFO                              # Options: DEBUG, INFO, WARNING, ERROR
LOG_JSON=true                               # Structured JSON logging for ELK/Loki
METRICS_ENABLED=true                        # Prometheus metrics endpoint at /metrics

# --- Security & Cryptographic Secrets ---
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_at_least_32_characters_random_hex_string_for_jwt_auth!

# Blind index key (HMAC-SHA256 for searching encrypted phone numbers)
# Generate with: openssl rand -hex 32
BLIND_INDEX_KEY=replace_with_at_least_32_characters_random_hex_for_phone_blind_index!

# AES-256-GCM master encryption key (base64 encoded 32-byte key)
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=replace_with_base64_encoded_32_byte_aes256_encryption_master_key=

# Token expiration configuration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
POSTGRES_USER=phoneintel
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=phoneintel
DATABASE_URL=postgresql+asyncpg://phoneintel:replace_with_strong_random_db_password@postgres:5432/phoneintel

# --- Redis & Task Queue ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
JOB_BACKEND=arq                             # Options: arq (production), inline (tests)

# --- Telegram Bot Service Account ---
# Provisioned via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# API Key matching a service account with `telegram:act_as` scope in backend
TELEGRAM_SERVICE_API_KEY=replace_with_phoneintel_backend_service_token

# --- External OSINT & Metadata Providers (Optional with graceful fallback) ---
# Google Custom Search API
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Brave Search API
BRAVE_SEARCH_API_KEY=

# Phone Carrier / Metadata Providers
NUMVERIFY_API_KEY=
VERIPHONE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
