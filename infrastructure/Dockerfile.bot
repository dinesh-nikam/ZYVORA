# PHONEINTEL Telegram bot image (long polling; thin client over the REST API).
# Build from the repository root:  docker build -f infrastructure/Dockerfile.bot -t phoneintel/bot .

FROM python:3.12-slim AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY telegram_bot/pyproject.toml /src/telegram_bot/pyproject.toml
COPY telegram_bot/phoneintel_bot /src/telegram_bot/phoneintel_bot
RUN pip install /src/telegram_bot

FROM python:3.12-slim
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin phoneintel
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=build /opt/venv /opt/venv
USER 10001
CMD ["phoneintel-bot"]
