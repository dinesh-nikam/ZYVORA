# Public TLS edge for the PHONEINTEL API. Caddy obtains and renews the certificate
# automatically (ACME); PUBLIC_HOSTNAME must resolve to this host and ports 80/443 must be open.
{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOSTNAME} {
	encode zstd gzip
	header -Server

	# Prometheus scrapes the API on the internal network; metrics are never served publicly.
	respond /metrics* 404

	# Caddy sets X-Forwarded-For/-Proto/-Host itself and ignores client-supplied values.
	reverse_proxy api:8000
}
