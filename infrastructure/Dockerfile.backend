# PHONEINTEL backend image. One image, three roles (selected by the compose command):
#   api     uvicorn app.main:app_factory --factory   (default CMD)
#   worker  arq app.workers.worker.WorkerSettings
#   migrate alembic upgrade head
# Build from the repository root:  docker build -f infrastructure/Dockerfile.backend -t phoneintel/backend .

FROM python:3.12-slim AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY backend/pyproject.toml /src/backend/pyproject.toml
COPY backend/app /src/backend/app
# Regular (non-editable) install: the runtime stage needs only the venv.
RUN pip install "/src/backend[otel]"

FROM python:3.12-slim
# DejaVu gives the PDF exporter a Unicode font (non-Latin names, scripts and URLs).
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin phoneintel
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
COPY backend/alembic.ini ./alembic.ini
COPY backend/migrations ./migrations
USER 10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=3)"]
# --proxy-headers trusts X-Forwarded-* only from FORWARDED_ALLOW_IPS (set to the reverse proxy's address).
CMD ["uvicorn", "app.main:app_factory", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--no-server-header"]
